---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import { gym, courses } from '../../../data/gym.js';
import { langPaths, t, path } from '../../../i18n/index.js';

export function getStaticPaths() {
  return langPaths().flatMap(({ params, props }) =>
    courses.map((course) => ({
      params: { ...params, slug: course.slug },
      props: { ...props, course },
    }))
  );
}

const { lang, course } = Astro.props;
const L = t(lang);
const C = L.courses;
const data = L.courseData[course.slug];

const others = courses
  .filter((c) => c.slug !== course.slug)
  .slice(0, 3)
  .map((c) => ({ ...c, ...L.courseData[c.slug] }));

const waHref = `https://wa.me/${gym.whatsapp}?text=${encodeURIComponent(L.common.whatsappCourse(data.name))}`;

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: L.schema.breadcrumbHome, item: new URL(path(lang, '/'), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: L.schema.breadcrumbCourses, item: new URL(path(lang, '/corsi/'), Astro.site).href },
    { '@type': 'ListItem', position: 3, name: data.name },
  ],
};
---

<Base
  title={`${data.name} — ${data.kicker}`}
  description={C.seoDetail(data.name, data.kicker, data.tagline, data.level)}
  lang={lang}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} is:inline />

  <PageHero kicker={`${C.kicker} / ${data.kicker}`} ghost={data.name.split(' ')[0]}>
    {data.name}<span style={`color:${course.accent}`}>.</span>
    <Fragment slot="extra">
      <p class="lead course-lead">{data.tagline}</p>
    </Fragment>
  </PageHero>

  <section class="section">
    <div class="container grid-2">
      <aside class="course-side" data-reveal="left">
        <div class="card flow">
          <p class="eyebrow">{C.labelBrief}</p>
          <dl class="course-facts">
            <div><dt>{C.labelLevel}</dt><dd>{data.level}</dd></div>
            <div><dt>{C.labelWhen}</dt><dd>{data.schedule}</dd></div>
            <div><dt>{C.labelWhere}</dt><dd>{gym.address.street}, {gym.address.city}</dd></div>
            <div>
              <dt>{C.labelIncluded}</dt>
              <dd>{gym.showPricing
                ? <a class="link-underline" href={path(lang, '/prezzi/')}>{C.includedIn}</a>
                : C.includedIn}</dd>
            </div>
          </dl>
          <a class="btn btn--accent" href={waHref} target="_blank" rel="noopener">
            <span class="btn-label">{L.common.ctaInfo}</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </aside>

      <div class="stack-lg">
        <h2 class="display display--md" data-split>{C.detailTitle}</h2>
        <p class="lead muted" data-reveal>{data.description}</p>
        <ul class="benefits" role="list">
          {data.bullets.map((b, i) => (
            <li class="benefits__item" data-reveal data-reveal-delay={i * 0.05}>
              <span class="benefits__num tabular" style={`color:${course.accent}`}>0{i + 1}</span>
              {b}
            </li>
          ))}
        </ul>
        <p class="small muted" data-reveal="fade">{C.detailNote}</p>
      </div>
    </div>
  </section>

  <section class="section section--flush related">
    <div class="container">
      <div class="related__head">
        <p class="eyebrow">{C.related}</p>
      </div>
      <div class="related__grid">
        {others.map((o) => (
          <a class="card related__card" href={path(lang, `/corsi/${o.slug}/`)} data-reveal>
            <span class="related__kicker" style={`color:${o.accent}`}>{o.kicker}</span>
            <span class="display display--sm">{o.name}</span>
            <span class="related__arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .course-lead { max-width: 38em; }
  .course-side { position: sticky; top: calc(var(--header-h) + 1.5rem); }
  .course-facts { display: grid; gap: 1rem; margin: 0; }
  .course-facts div {
    display: grid;
    gap: 0.2rem;
    padding-bottom: 1rem;
    border-bottom: 1.5px solid var(--line);
  }
  .course-facts dt {
    font-size: 0.75rem;
    font-weight: 700;
    font-stretch: 85%;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--t-muted);
  }
  .course-facts dd { margin: 0; font-weight: 640; }

  .benefits { padding: 0; display: grid; gap: 0; border-top: 1.5px solid var(--line); }
  .benefits__item {
    list-style: none;
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding-block: 1.1rem;
    border-bottom: 1.5px solid var(--line);
    font-weight: 560;
    font-size: 1.05rem;
  }
  .benefits__num { font-weight: 800; font-size: 0.85rem; }

  .related { padding-bottom: var(--section); }
  .related__head { margin-bottom: 1.75rem; }
  .related__grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .related__card {
    display: grid;
    gap: 0.6rem;
    text-decoration: none;
    container-type: inline-size;
  }
  .related__card > * { min-width: 0; }
  .related__card > :global(.display--sm) {
    font-size: clamp(1.2rem, 10cqi, 1.9rem);
  }
  .related__card:hover { transform: translateY(-0.3rem); }
  .related__kicker {
    font-size: 0.75rem;
    font-weight: 700;
    font-stretch: 85%;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }
  .related__arrow { justify-self: end; font-size: 1.3rem; opacity: 0.5; }
  .related__card:hover .related__arrow { opacity: 1; color: var(--accent); }

  @media (max-width: 60rem) {
    .course-side { position: static; }
  }
</style>
