---
import { gym } from '../data/gym.js';
import { t, path, stripLang, DEFAULT_LANG } from '../i18n/index.js';

interface Props { lang?: string; }
const { lang = DEFAULT_LANG } = Astro.props;
const L = t(lang);

const navKeys = ['corsi', 'prezzi', 'chi-siamo', 'regolamento', 'contatti']
  .filter((key) => key !== 'prezzi' || gym.showPricing);
const nav = navKeys.map((key) => ({
  href: path(lang, `/${key}/`),
  label: L.nav[key],
}));
const current = Astro.url.pathname;

// stessa pagina nell'altra lingua
const other = lang === 'en' ? 'it' : 'en';
const otherHref = path(other, stripLang(current));
---

<header class="header" id="site-header">
  <div class="header__inner">
    <a class="wordmark" href={path(lang, '/')} aria-label={`${gym.name} — ${L.common.homeLabel}`}>
      <span>NONSOLO<svg class="wordmark__bolt" viewBox="0 0 24 40" aria-hidden="true"><path d="M14 0 L1 23 h8 L6 40 L23 15 h-9 L14 0 Z" fill="var(--accent)" /></svg>FITNESS</span>
    </a>

    <nav class="nav-desktop" aria-label={L.common.mainNav}>
      {nav.map((item) => (
        <a
          href={item.href}
          class="nav-link"
          aria-current={current.startsWith(item.href) ? 'page' : undefined}
        >{item.label}</a>
      ))}
    </nav>

    <div class="header__actions">
      <a class="lang-switch" href={otherHref} hreflang={other} lang={other} aria-label={L.switchTo}>
        <span class="lang-switch__on">{lang.toUpperCase()}</span>
        <span class="lang-switch__off">{L.switchToShort}</span>
      </a>
      <a class="btn btn--accent header__cta" href={path(lang, '/contatti/')}>
        <span class="btn-label">{L.common.ctaTry}</span>
      </a>
      <button
        class="burger"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={L.common.openMenu}
        data-label-open={L.common.openMenu}
        data-label-close={L.common.closeMenu}
      >
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden>
    <nav aria-label={L.common.mobileNav}>
      {nav.map((item, i) => (
        <a href={item.href} class="mobile-nav__link" style={`--i:${i}`}>
          <span class="mobile-nav__num">0{i + 1}</span>
          {item.label}
        </a>
      ))}
    </nav>
    {/* Piede del menu: CTA principale + telefono e social CON icone.
        Niente link "English": il selettore IT/EN sta già in alto. */}
    <div class="mobile-nav__foot">
      <a class="btn btn--accent mobile-nav__cta" href={path(lang, '/contatti/')}>
        <span class="btn-label">{L.common.ctaTry}</span>
        <span class="btn-arrow" aria-hidden="true">→</span>
      </a>
      <div class="mobile-nav__row">
        <a class="mobile-nav__phone" href={`tel:${gym.phoneHref}`}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8Z"/></svg>
          {gym.phone}
        </a>
        <div class="mobile-nav__social">
          <a href={gym.social.instagram} target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.9.9 1.4.2.4.4 1.1.4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.9.7-1.4.9-.4.2-1.1.4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.9-.9-1.4-.2-.4-.4-1.1-.4-2.2-.1-1.3-.1-1.7-.1-4.9s0-3.6.1-4.9c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.9-.7 1.4-.9.4-.2 1.1-.4 2.2-.4 1.3-.1 1.7-.1 4.9-.1Zm0 1.8c-3.1 0-3.5 0-4.8.1-1.1.1-1.5.2-1.9.3-.5.2-.8.4-1.1.7-.3.3-.5.6-.7 1.1-.1.4-.3.8-.3 1.9-.1 1.3-.1 1.7-.1 4.8s0 3.5.1 4.8c.1 1.1.2 1.5.3 1.9.2.5.4.8.7 1.1.3.3.6.5 1.1.7.4.1.8.3 1.9.3 1.3.1 1.7.1 4.8.1s3.5 0 4.8-.1c1.1-.1 1.5-.2 1.9-.3.5-.2.8-.4 1.1-.7.3-.3.5-.6.7-1.1.1-.4.3-.8.3-1.9.1-1.3.1-1.7.1-4.8s0-3.5-.1-4.8c-.1-1.1-.2-1.5-.3-1.9-.2-.5-.4-.8-.7-1.1-.3-.3-.6-.5-1.1-.7-.4-.1-.8-.3-1.9-.3-1.3-.1-1.7-.1-4.8-.1Zm0 3.1a4.9 4.9 0 1 1 0 9.8 4.9 4.9 0 0 1 0-9.8Zm0 1.8a3.1 3.1 0 1 0 0 6.2 3.1 3.1 0 0 0 0-6.2Zm5.1-2.1a1.1 1.1 0 1 1 0 2.3 1.1 1.1 0 0 1 0-2.3Z"/></svg>
          </a>
          <a href={gym.social.facebook} target="_blank" rel="noopener" aria-label="Facebook">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-7h2.4l.4-3h-2.8V9.1c0-.9.3-1.5 1.6-1.5h1.3V4.9c-.2 0-1-.1-1.9-.1-1.9 0-3.2 1.2-3.2 3.3V11H8.9v3h2.4v7h2.2Z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  /* Sempre visibile: non si nasconde mai, né scendendo né salendo.
     LA RICETTA (copiata 1:1 dal nav di Cuocimi, dove la barra di stato
     resta piena sullo stesso telefono): position FIXED + fondo
     TRANSLUCIDO (alpha 0.95). Safari tratta le barre fisse translucide
     come vetro di sistema — come le sue — e ne ESTENDE il colore
     attraverso la barra di stato; una barra opaca è solo contenuto e
     dietro l'orologio proietta la pagina. Provati separatamente
     (fixed+opaco: no; sticky+translucido: no): serve la coppia esatta.
     La prova nella foto dell'utente: dietro il logo CUOCIMI traspare il
     testo "…PASTI" — la firma dell'alpha 0.95 — e la fascia è piena. */
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 1000;
    padding-top: var(--safe-top);
    color: var(--paper);
    background: transparent;
    transition: background-color 0.35s, box-shadow 0.35s;
  }
  /* Da scrollato: fondo TRANSLUCIDO (0.95), mai opaco — è il pattern esatto
     del nav di Cuocimi (trasparente in cima, carbone/95 da scrollato), il
     progetto di riferimento dove la barra di stato di iOS si comporta bene.
     Non cambiare l'alpha in 1: le barre fisse translucide sono quelle che
     Safari tratta come vetro di sistema. */
  .header.is-scrolled {
    background: rgb(13 13 16 / 0.95);
    box-shadow: 0 1px 0 rgb(242 238 229 / 0.12);
  }
  /* NB: niente visiera ::before né altri trucchi qui — Safari 26 ritaglia
     l'overflow degli elementi fissi e il suo campionatore di tinta ignora
     gli pseudo-elementi. La fascia di stato la copre .ios-strip (Base.astro). */
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--header-bar);
    padding-inline: var(--gutter);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    font-stretch: 118%;
    font-weight: 860;
    font-size: 1.05rem;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
  }
  .wordmark__bolt {
    display: inline-block;
    height: 0.92em;
    width: auto;
    margin-inline: 0.1em;
    vertical-align: -0.1em;
  }

  .nav-desktop { display: none; gap: 2rem; }
  .nav-link {
    font-size: 0.85rem;
    font-weight: 640;
    font-stretch: 88%;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    text-decoration: none;
    opacity: 0.85;
    transition: opacity 0.25s, color 0.25s;
  }
  .nav-link:hover { opacity: 1; color: var(--accent); }
  .nav-link[aria-current='page'] {
    opacity: 1;
    color: var(--accent);
  }

  .header__actions { display: flex; align-items: center; gap: 1rem; }
  .header__cta { padding: 0.75em 1.4em; font-size: 0.8rem; }

  /* Selettore lingua: pillola con lingua attiva + quella alternativa */
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.4em 0.75em;
    border: 1.5px solid rgb(242 238 229 / 0.28);
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    font-stretch: 85%;
    letter-spacing: 0.1em;
    text-decoration: none;
    transition: border-color 0.3s, background-color 0.3s;
  }
  .lang-switch:hover, .lang-switch:focus-visible {
    border-color: var(--accent);
    background: rgb(217 4 41 / 0.16);
  }
  .lang-switch__on { color: var(--paper); }
  .lang-switch__off { color: rgb(242 238 229 / 0.5); }
  .lang-switch:hover .lang-switch__off { color: var(--accent); }

  .burger {
    display: grid;
    gap: 0.42rem;
    padding: 0.9rem 0.6rem;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .burger span {
    width: 1.7rem;
    height: 2px;
    background: currentColor;
    transition: rotate 0.35s var(--ease-out), translate 0.35s var(--ease-out);
  }
  .burger[aria-expanded='true'] span:first-child { rotate: 45deg; translate: 0 0.28rem; }
  .burger[aria-expanded='true'] span:last-child { rotate: -45deg; translate: 0 -0.28rem; }

  .mobile-nav[hidden] { display: none; }
  .mobile-nav {
    position: fixed;
    inset: 0;
    z-index: -1;
    color: var(--paper); /* il menu è sempre scuro, anche con header chiaro */
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: calc(var(--header-h) + 2rem) var(--gutter) 2.5rem;
    background: var(--ink);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
  }
  .mobile-nav.is-open { opacity: 1; }
  .mobile-nav__link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.35em;
    font-stretch: 118%;
    font-weight: 860;
    font-size: clamp(2rem, 8vw, 3.6rem);
    line-height: 1.05;
    text-transform: uppercase;
    text-decoration: none;
    translate: 0 1.2em;
    opacity: 0;
    transition: translate 0.6s var(--ease-out), opacity 0.6s var(--ease-out), color 0.25s;
    transition-delay: calc(var(--i) * 60ms);
  }
  .mobile-nav.is-open .mobile-nav__link { translate: 0 0; opacity: 1; }
  .mobile-nav__link:hover { color: var(--accent); }
  .mobile-nav__num {
    font-size: 0.9rem;
    font-stretch: 85%;
    font-weight: 640;
    color: var(--accent);
  }
  .mobile-nav__foot {
    display: grid;
    gap: 1.4rem;
  }
  .mobile-nav__cta {
    justify-content: center;
    padding: 1.05em 2rem;
    font-size: 0.95rem;
  }
  .mobile-nav__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .mobile-nav__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
  }
  .mobile-nav__phone svg { color: var(--accent); }
  .mobile-nav__social { display: flex; gap: 0.75rem; }
  .mobile-nav__social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1.5px solid rgb(242 238 229 / 0.28);
    border-radius: 999px;
    color: var(--paper);
    transition: border-color 0.3s, background-color 0.3s;
  }
  .mobile-nav__social a:hover,
  .mobile-nav__social a:focus-visible {
    border-color: var(--accent);
    background: rgb(217 4 41 / 0.16);
  }

  @media (min-width: 68rem) {
    .nav-desktop { display: flex; }
    .burger { display: none; }
  }
  @media (max-width: 44rem) {
    .header__cta { display: none; }
  }
</style>
